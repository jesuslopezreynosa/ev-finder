{
    "name": "ev-finder",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npx svgo --folder src/assets/icons --recursive && run-p type-check \"build-only {@}\" --",
        "preview": "vite preview",
        "build-only": "vite build",
        "type-check": "vue-tsc --build",
        "predeploy": "npm run type-check && npm run build-only",
        "deploy": "gh-pages -d dist --cname ev-finder.jlr.pw"
    },
    "dependencies": {
        "i18n-iso-countries": "^7.14.0",
        "markdown-it": "^15.0.1",
        "markdown-it-mathjax3": "^5.2.0",
        "vue": "^3.5.42"
    },
    "devDependencies": {
        "@tsconfig/node24": "^24.0.5",
        "@types/markdown-it": "^14.2.0",
        "@types/node": "^26.4.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/tsconfig": "^0.9.1",
        "gh-pages": "^6.3.0",
        "npm-run-all2": "^9.0.3",
        "svgo": "^4.0.1",
        "typescript": "~7.0.2",
        "vite": "^8.2.2",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vue-tsc": "^3.3.11"
    },
    "engines": {
        "node": "^22.18.0 || >=24.12.0"
    },
    "allowScripts": {
        "fsevents@2.3.3": true
    }
}